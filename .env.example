# OpenMimicry environment template.
#
# Copy to `.env` (already in .gitignore) and fill in only the keys you
# actually use. `OPENMIMICRY_PROFILE` picks the YAML profile under
# `config/profiles/`; everything else is provider-specific.
#
# Loading the file:
#
#   • make target / Linux / macOS / WSL:
#       set -a; source .env; set +a; make backend
#
#   • PowerShell:
#       Get-Content .env | ForEach-Object {
#           if ($_ -match '^\s*([^#=][^=]*)=(.*)$') {
#               [System.Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim())
#           }
#       }
#       make backend         # or scripts\win\backend.bat
#
#   • Docker compose reads `.env` automatically; no extra step needed.

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------

# Which profile to load. `basic` = mocks only (no real network).
# Other options: voice | threejs | live3d | unity | agent | vision |
#                full | full-vision | studio | dev
OPENMIMICRY_PROFILE=basic

# Optional explicit config path (overrides the profile auto-resolution).
# Useful for one-off configs you don't want to check in.
# OPENMIMICRY_CONFIG_PATH=./config/my-local.yaml

# FastAPI bind. Leave default for local dev; Docker compose overrides
# these via the service env. Set OPENMIMICRY_HOST=0.0.0.0 to listen on
# all interfaces (only do this if you trust the network).
OPENMIMICRY_HOST=127.0.0.1
OPENMIMICRY_PORT=8000

# Set to "1" to expose GET /config in the backend (debug-only).
# OPENMIMICRY_DEBUG=1

# ---------------------------------------------------------------------------
# LLM providers (only used when llm.adapter != "mock" in the profile)
# ---------------------------------------------------------------------------
# The LiteLLM adapter reads whichever provider env var matches the
# `model` string in your profile (e.g. "openrouter/anthropic/claude-3.5-sonnet"
# → OPENROUTER_API_KEY; "openai/gpt-4o-mini" → OPENAI_API_KEY).

OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
GROQ_API_KEY=

# Local Ollama (no key needed; the URL is enough).
OLLAMA_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# Task adapters (M5)
# ---------------------------------------------------------------------------
# ClaudeCodeAdapter: path to the `claude` CLI when shutil.which can't
# find it. Leave empty to use the PATH default.
# CLAUDE_BIN=
# CLAUDE_HOME=

# ---------------------------------------------------------------------------
# Vision (M13 — optional, off by default)
# ---------------------------------------------------------------------------
# Set to "1" to let `make doctor` probe camera index 0 (otherwise it
# just reports which Python deps are importable).
# OPENMIMICRY_DOCTOR_PROBE_CAMERA=1

# ---------------------------------------------------------------------------
# Docker compose
# ---------------------------------------------------------------------------
# Override exposed ports (defaults match the dev workflow).
# OPENMIMICRY_BACKEND_PORT=8000
# OPENMIMICRY_FRONTEND_PORT=5173
