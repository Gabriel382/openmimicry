    "@testing-library/user-event": "^14.6.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "^25.0.1",
